<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules for API 31+, see
   https://developer.android.com/about/versions/12/backup-restore#xml-changes
   The Room database stores MediaStore photo IDs, which are not stable across devices.
   A restored copy could point at unrelated photos, so it is never backed up or transferred.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="memorylane.db" />
        <exclude domain="database" path="memorylane.db-wal" />
        <exclude domain="database" path="memorylane.db-shm" />
        <exclude domain="database" path="memorylane.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="memorylane.db" />
        <exclude domain="database" path="memorylane.db-wal" />
        <exclude domain="database" path="memorylane.db-shm" />
        <exclude domain="database" path="memorylane.db-journal" />
    </device-transfer>
</data-extraction-rules>
