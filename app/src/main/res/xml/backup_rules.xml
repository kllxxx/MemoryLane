<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for API < 31, see
   https://developer.android.com/guide/topics/data/autobackup
   The Room database stores MediaStore photo IDs, which are not stable across devices.
   A restored copy could point at unrelated photos, so it is never backed up. The -wal, -shm
   and -journal files are Room's sidecar files and must be excluded together with the database.
-->
<full-backup-content>
    <exclude domain="database" path="memorylane.db" />
    <exclude domain="database" path="memorylane.db-wal" />
    <exclude domain="database" path="memorylane.db-shm" />
    <exclude domain="database" path="memorylane.db-journal" />
</full-backup-content>
